{
  "name": "agentic-avg-maker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/server.mjs",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/cli.mjs check --project projects/last-program",
    "engine:build": "node scripts/build-engine.mjs",
    "engine:verify": "node scripts/engine-runtime.mjs",
    "doctor": "node scripts/cli.mjs doctor",
    "skill:pack": "node scripts/pack-skill.mjs",
    "product:build": "npm run build && npm run skill:pack && npm run minigames:pack && npm run source:pack && node scripts/build-product.mjs",
    "product:verify": "node scripts/verify-product.mjs",
    "minigames:build": "node scripts/build-minigames.mjs wechatgame bytedance-mini-game",
    "minigames:pack": "node scripts/pack-minigames.mjs",
    "minigames:test": "node --test tests/minigames/*.test.mjs",
    "source:pack": "node scripts/pack-source.mjs",
    "distribution:test": "python tests/distribution-smoke.py"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "archiver": "^7.0.1",
    "express": "^4.21.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "marked": "^15.0.12",
    "esbuild": "^0.25.12"
  },
  "license": "MIT",
  "description": "豆剧场：与 AI Agent 合作创作文字冒险和轻养成游戏。"
}
