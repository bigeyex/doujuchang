[1,0,0,[["cc.JsonAsset",["_name","json"],1]],[[0,0,1,3]],[[0,"project",{"schemaVersion":1,"id":"last-program","name":"最后一张节目单","defaultScreen":"game","startScreen":"title","display":{"orientation":"portrait","shortEdge":720,"longEdge":1280},"splash":{"enabled":true,"duration":1.2,"screen":"splash"},"scripts":[{"id":"main","name":"放学后","path":"scripts/main.avg","source":"// 最后一张节目单 · 文化节前一天\n[背景 hall_evening 转场=淡入淡出 时长=0.5]\n[音效 bell]\n[显示 lin 表情=normal 位置=左侧]\n放学铃响过第三遍，走廊里只剩下公告栏前的两个人。\nlin: 节目单上为什么没有我们班？\n\n[显示 chen 表情=normal 位置=右侧]\nchen: 是我交的。但我没有删掉任何节目。\nlin: 大家排练了一个月。明天就要上台了。\nchen: 我知道。\n\n[调用 investigate]\n[选择]\n  [选项 文本=先听陈默解释 目标=#listen]\n  [选项 文本=要求公开提交记录 目标=#records]\n[/选择]\n[标签 listen]\n[设置 trust += 1]\nlin: 好，你从头说。我听着。\nchen: 被撤下的不只有我们班。知遥的独唱也不见了。\n[跳转 decision]\n[标签 records]\n[显示 lin 表情=angry 位置=左侧]\n[动画 lin 动画=抖动 时长=0.3]\nlin: 把记录公开吧。至少别让大家继续猜。\nchen: 可以。但那份记录里，不只有节目名字。\n[跳转 decision]\n[选择]\n  [选项 文本=继续 目标=main]\n[/选择]"},{"id":"investigate","name":"广播室","path":"scripts/investigate.avg","source":"[背景 radio 转场=淡入淡出 时长=0.4]\n电脑没有关机。提交记录里，最后一次修改来自学生会账号。\nlin: 撤回申请……是知遥自己发的？\nchen: 她母亲住院了。她不想让同学们知道。\nlin: 可为什么连我们班也一起——\nchen: 音响只有一套。她退出以后，老师把整段时间给了赞助商。\n\n[设置 evidence = 真]\n屏幕右下角，一封还未发出的说明邮件停在草稿箱。\nchen: 我想先说服老师，给我们换一个时间。还没来得及。\n[返回]"},{"id":"decision","name":"最后的选择","path":"scripts/decision.avg","source":"[背景 rooftop 转场=淡入淡出 时长=0.5]\n天台上的风把节目单吹得哗哗响。许知遥站在门边。\nxu: 你们都看到了，对吗？\nlin: 我们可以把你的名字遮掉。\nxu: 大家知道谁是独唱。遮掉名字，也会猜到的。\n\n[弹窗 attributes]\nchen: 离彩排还有半小时。我们得做个决定。\n\n[选择]\n  [选项 文本=公开记录争取原定场次 目标=ending#public 条件=evidence]\n  [选项 文本=和他们一起找老师协商 目标=ending#together 条件={trust >= 1}]\n  [选项 文本=先保护知遥另找演出机会 目标=ending#quiet]\n[/选择]"},{"id":"training","name":"练习片段","path":"scripts/training.avg","source":"// 可绑定到 UI 按钮，也可以 call\n[如果 attr.health >= 10]\n  [显示 lin 表情=normal 位置=左侧]\n  [动画 lin 动画=练习 时长=0.5]\n  [设置 attr.health -= 10]\n  [设置 attr.study += 1]\n[否则]\n  lin: 先休息一下吧。\n[/如果]\n[返回]"},{"id":"practice","name":"循环示例","path":"scripts/practice.avg","source":"[背景 rooftop]\n[显示 lin 表情=normal 位置=中央]\n[循环 attr.health >= 10]\n  lin: 再练一次。今天已经练习了 {attr.study} 次。\n  [调用 training]\n[/循环]\nlin: 今天就到这里吧。\n[返回]"},{"id":"ending","name":"三个结局","path":"scripts/ending.avg","source":"[标签 public]\n记录很快传遍了班群。演出时间保住了。\n知遥的名字没有出现在截图里，但她的手机还是响了一整晚。\nlin: 我们赢了吗？\n陈默没有回答。远处，礼堂的灯一盏盏亮了起来。\n\n结局一 · 灯亮以后\n[结束]\n[标签 together]\n三个人一起敲开了办公室的门。\n节目被安排到闭幕前。没有最好的灯光，却有足够的时间。\nxu: 明天，我坐在台下听。\nlin: 好。那个位置给你留着。\n\n结局二 · 留给你的座位\n[结束]\n[标签 quiet]\n他们撤回了公开说明，在操场边搭起一只小音箱。\n没有正式节目单，也没有主持人。下课后，却有越来越多人停下来。\nchen: 下次，早点告诉我们。\nxu: 嗯。下次一定。\n\n结局三 · 没有写下的节目\n[结束]"}],"variables":{"evidence":{"type":"boolean","default":false},"trust":{"type":"number","default":0},"attr.health":{"type":"number","default":30},"attr.maxHealth":{"type":"number","default":100},"attr.study":{"type":"number","default":0},"playerName":{"type":"string","default":"新同学"}},"characters":[{"id":"lin","name":"林夏","color":"#edbd9f","poses":[{"id":"normal","name":"坚定","image":"story-assets/characters/lin/normal.png","crop":0.32,"scale":1,"framing":"bust","faceCenter":{"u":0.59,"v":0.28}},{"id":"angry","name":"生气","image":"story-assets/characters/lin/angry.png","crop":0.32,"scale":1,"framing":"bust","faceCenter":{"u":0.59,"v":0.28}}]},{"id":"chen","name":"陈默","color":"#a8c6da","poses":[{"id":"normal","name":"犹豫","image":"story-assets/characters/chen/normal.png","crop":0.32,"scale":1,"framing":"bust","faceCenter":{"u":0.48,"v":0.28}}]},{"id":"xu","name":"许知遥","color":"#cbb6e1","poses":[]}],"backgrounds":[{"id":"hall_evening","name":"放学后的走廊","image":"story-assets/backgrounds/hall.png","transition":"fade","duration":0.4,"rect":{"x":0.5,"y":0.5,"w":1.1851851851851853,"h":1},"reference":{"width":720,"height":1280}},{"id":"radio","name":"广播室","image":"story-assets/backgrounds/radio.png","transition":"fade","duration":0.4,"rect":{"x":0.4907192257741476,"y":0.5,"w":1.1851851851851853,"h":1},"reference":{"width":720,"height":1280}},{"id":"rooftop","name":"天台","image":"story-assets/backgrounds/roof.png","transition":"fade","