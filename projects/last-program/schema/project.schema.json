{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AVG Maker project workspace",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "display",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "startScreen": {
      "type": "string"
    },
    "defaultScreen": {
      "type": "string"
    },
    "display": {
      "type": "object",
      "required": [
        "orientation",
        "shortEdge",
        "longEdge"
      ],
      "properties": {
        "orientation": {
          "enum": [
            "portrait",
            "landscape"
          ]
        },
        "shortEdge": {
          "type": "number",
          "minimum": 240
        },
        "longEdge": {
          "type": "number",
          "minimum": 240
        }
      }
    },
    "files": {
      "type": "object",
      "required": [
        "scripts",
        "variables",
        "characters",
        "backgrounds",
        "audio",
        "screens",
        "theme"
      ],
      "additionalProperties": {
        "type": "string",
        "pattern": "^[^:]+\\.json$"
      }
    }
  },
  "$defs": {
    "scriptIndex": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "pattern": "\\.avg$"
          }
        }
      }
    },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "type",
              "default"
            ],
            "properties": {
              "type": {
                "const": "number"
              },
              "default": {
                "type": "number"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "default"
            ],
            "properties": {
              "type": {
                "const": "boolean"
              },
              "default": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "default"
            ],
            "properties": {
              "type": {
                "const": "string"
              },
              "default": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "poses"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "poses": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "image",
                "faceCenter"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "image": {
                  "type": "string"
                },
                "framing": {
                  "enum": [
                    "bust",
                    "full"
                  ]
                },
                "faceCenter": {
                  "type": "object",
                  "required": [
                    "u",
                    "v"
                  ],
                  "properties": {
                    "u": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "v": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                },
                "crop": {
                  "type": "number",
                  "minimum": 0.05,
                  "maximum": 1
                },
                "scale": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          }
        }
      }
    },
    "backgrounds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "image"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "fit": {
            "enum": [
              "cover",
              "contain"
            ]
          },
          "focusX": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "focusY": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "rect": {
            "$ref": "#/$defs/rect"
          },
          "reference": {
            "type": "object",
            "required": [
              "width",
              "height"
            ],
            "properties": {
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    },
    "audio": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "file"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "audio",
              "sound",
              "bgm"
            ]
          },
          "volume": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "paper": {
          "type": "string"
        },
        "panel": {
          "type": "string"
        },
        "ink": {
          "type": "string"
        },
        "accent": {
          "type": "string"
        }
      }
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "controls"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "base",
              "popup"
            ]
          },
          "title": {
            "type": "string"
          },
          "background": {
            "type": "string"
          },
          "dialogue": {
            "allOf": [
              {
                "$ref": "#/$defs/rect"
              },
              {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "string"
                  },
                  "speaker": {
                    "$ref": "#/$defs/dialoguePart"
                  },
                  "text": {
                    "$ref": "#/$defs/dialoguePart"
                  },
                  "fontSize": {
                    "type": "number"
                  },
                  "color": {
                    "type": "string"
                  },
                  "background": {
                    "type": "string"
                  },
                  "opacity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 255
                  }
                }
              }
            ]
          },
          "controls": {
            "type": "array",
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/rect"
                },
                {
                  "type": "object",
                  "required": [
                    "id",
                    "name",
                    "type"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "type": {
                      "enum": [
                        "text",
                        "button",
                        "image",
                        "panel",
                        "progress",
                        "slider",
                        "toggle",
                        "input",
                        "history"
                      ]
                    },
                    "text": {
                      "type": "string"
                    },
                    "image": {
                      "type": "string"
                    },
                    "fontSize": {
                      "type": "number"
                    },
                    "color": {
                      "type": "string"
                    },
                    "textColor": {
                      "type": "string"
                    },
                    "radius": {
                      "type": "number"
                    },
                    "bind": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    },
                    "max": {
                      "type": "string"
                    },
                    "visible": {
                      "type": "string"
                    },
                    "enabled": {
                      "type": "string"
                    },
                    "actions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "type"
                        ],
                        "properties": {
                          "type": {
                            "enum": [
                              "call",
                              "popup",
                              "close",
                              "switch",
                              "start",
                              "save",
                              "load",
                              "history"
                            ]
                          },
                          "target": {
                            "type": "string"
                          },
                          "closeAfter": {
                            "type": "boolean"
                          },
                          "closeBefore": {
                            "type": "boolean"
                          }
                        }
                      }
                    },
                    "hoverImage": {
                      "type": "string"
                    },
                    "pressedImage": {
                      "type": "string"
                    },
                    "disabledImage": {
                      "type": "string"
                    },
                    "onImage": {
                      "type": "string"
                    },
                    "offImage": {
                      "type": "string"
                    },
                    "trackImage": {
                      "type": "string"
                    },
                    "fillImage": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "rect": {
      "type": "object",
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "videos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "file"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "file": {
            "type": "string",
            "pattern": "\\.mp4$"
          },
          "kind": {
            "const": "video"
          },
          "volume": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "dialoguePart": {
      "allOf": [
        {
          "$ref": "#/$defs/rect"
        },
        {
          "type": "object",
          "properties": {
            "image": {
              "type": "string"
            },
            "color": {
              "type": "string"
            },
            "background": {
              "type": "string"
            },
            "fontSize": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      ]
    }
  }
}
